{
  "Comment": "SmartRetailX — EventBridge Rules and SQS Queue Configuration",
  "EventBusName": "smartretailx-event-bus",

  "SQSQueues": [
    {
      "QueueName":            "smartretailx-payment-queue",
      "DeadLetterQueueName":  "smartretailx-payment-queue-dlq",
      "VisibilityTimeoutSec": 60,
      "MessageRetentionSec":  86400,
      "MaxReceiveCount":      3,
      "Consumer":             "PaymentService"
    },
    {
      "QueueName":            "smartretailx-inventory-queue",
      "DeadLetterQueueName":  "smartretailx-inventory-queue-dlq",
      "VisibilityTimeoutSec": 30,
      "MessageRetentionSec":  86400,
      "MaxReceiveCount":      3,
      "Consumer":             "InventoryService"
    },
    {
      "QueueName":            "smartretailx-notification-queue",
      "DeadLetterQueueName":  "smartretailx-notification-queue-dlq",
      "VisibilityTimeoutSec": 30,
      "MessageRetentionSec":  86400,
      "MaxReceiveCount":      3,
      "Consumer":             "NotificationService"
    },
    {
      "QueueName":            "smartretailx-order-update-queue",
      "DeadLetterQueueName":  "smartretailx-order-update-queue-dlq",
      "VisibilityTimeoutSec": 60,
      "MessageRetentionSec":  86400,
      "MaxReceiveCount":      3,
      "Consumer":             "OrderService (status updates)"
    }
  ],

  "EventBridgeRules": [

    {
      "RuleName": "route-order-created-to-payment",
      "EventPattern": {
        "source":      ["com.smartretailx.order-service"],
        "detail-type": ["OrderCreated"]
      },
      "Targets": [
        { "Id": "PaymentQueue", "Arn": "arn:aws:sqs:{region}:{account}:smartretailx-payment-queue" }
      ]
    },

    {
      "RuleName": "route-order-created-to-inventory",
      "EventPattern": {
        "source":      ["com.smartretailx.order-service"],
        "detail-type": ["OrderCreated"]
      },
      "Targets": [
        { "Id": "InventoryQueue", "Arn": "arn:aws:sqs:{region}:{account}:smartretailx-inventory-queue" }
      ]
    },

    {
      "RuleName": "route-order-created-to-notification",
      "EventPattern": {
        "source":      ["com.smartretailx.order-service"],
        "detail-type": ["OrderCreated"]
      },
      "Targets": [
        { "Id": "NotificationQueue", "Arn": "arn:aws:sqs:{region}:{account}:smartretailx-notification-queue" }
      ]
    },

    {
      "RuleName": "route-payment-completed-to-order",
      "EventPattern": {
        "source":      ["com.smartretailx.payment-service"],
        "detail-type": ["PaymentCompleted"]
      },
      "Targets": [
        { "Id": "OrderUpdateQueue",  "Arn": "arn:aws:sqs:{region}:{account}:smartretailx-order-update-queue" },
        { "Id": "NotificationQueue", "Arn": "arn:aws:sqs:{region}:{account}:smartretailx-notification-queue" }
      ]
    },

    {
      "RuleName": "route-payment-failed-to-order-inventory-notification",
      "EventPattern": {
        "source":      ["com.smartretailx.payment-service"],
        "detail-type": ["PaymentFailed"]
      },
      "Targets": [
        { "Id": "OrderUpdateQueue",  "Arn": "arn:aws:sqs:{region}:{account}:smartretailx-order-update-queue" },
        { "Id": "InventoryQueue",    "Arn": "arn:aws:sqs:{region}:{account}:smartretailx-inventory-queue" },
        { "Id": "NotificationQueue", "Arn": "arn:aws:sqs:{region}:{account}:smartretailx-notification-queue" }
      ]
    },

    {
      "RuleName": "route-inventory-updated-to-notification",
      "EventPattern": {
        "source":      ["com.smartretailx.inventory-service"],
        "detail-type": ["InventoryUpdated"],
        "detail": {
          "belowReorderLevel": [true]
        }
      },
      "Targets": [
        { "Id": "NotificationQueue", "Arn": "arn:aws:sqs:{region}:{account}:smartretailx-notification-queue" }
      ]
    },

    {
      "RuleName": "route-order-status-changed-to-notification",
      "EventPattern": {
        "source":      ["com.smartretailx.order-service"],
        "detail-type": ["OrderStatusChanged"]
      },
      "Targets": [
        { "Id": "NotificationQueue", "Arn": "arn:aws:sqs:{region}:{account}:smartretailx-notification-queue" }
      ]
    }

  ]
}
